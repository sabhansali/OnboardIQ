{
  "application_name": "OnboardIQ",
  "kb_match_threshold": 70,
  "kb_review_threshold": 40,
  "minimum_retrieval_score": 18,
  "sla_minutes": {
    "P1": 15,
    "P2": 60,
    "P3": 240,
    "P4": 1440
  },
  "resolution_sla_multiplier": 4,
  "sla_at_risk_minutes": 15,
  "pause_sla_when_on_hold": true,
  "notification_retry_attempts": 3,
  "notification_dead_letter_cycles": 2,
  "human_review_required_for_high_risk": true,
  "auto_resolve_requires_low_complexity": true,
  "allowed_intents": [
    "Workspace Setup",
    "Data Import & Migration",
    "Identity & Access",
    "Integration Setup",
    "Permissions & Security",
    "Product Guidance",
    "Feature Request",
    "Unresolved Implementation Issue",
    "Other"
  ],
  "allowed_complexities": ["Low", "Medium", "High"],
  "allowed_priorities": ["P1", "P2", "P3", "P4"],
  "teams": [
    "Onboarding Support",
    "Data Migration Team",
    "Identity & Security Team",
    "Integration Specialists",
    "Product Feedback",
    "Implementation Specialists",
    "Incident Response"
  ]
}
