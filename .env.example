# Optional Groq classification. Leave blank to use the deterministic classifier.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
USE_GROQ_CLASSIFIER=false

# Local demo login accounts (change these before using outside a local demo).
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=AdminDemo!2026
BOOTSTRAP_MANAGER_USERNAME=manager
BOOTSTRAP_MANAGER_PASSWORD=ManagerDemo!2026
BOOTSTRAP_SPECIALIST_USERNAME=specialist
BOOTSTRAP_SPECIALIST_PASSWORD=SpecialistDemo!2026

# Optional override. Relative paths are resolved from this project directory.
ONBOARDIQ_DB_PATH=onboardiq.db
